# ─────────────────────────────────────────────────────────────────────────────
# .env.example — plantilla de configuración. Copiá a `.env` y completá los valores.
# Las variables SIN default son OBLIGATORIAS: la app no arranca sin ellas.
# El resto son opcionales (se muestra el default entre comentarios).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Postgres ────────────────────────────────────────────────────────────────
# DATABASE_URL se construye automáticamente a partir de estas variables.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=team_hero_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ─── JWT ─────────────────────────────────────────────────────────────────────
# OBLIGATORIO. Mínimo 32 caracteres. Generá uno con: openssl rand -hex 32
SECRET_KEY=
# Opcionales (defaults):
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# OBLIGATORIOS. Subida de imágenes de productos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── MercadoPago ─────────────────────────────────────────────────────────────
# Opcionales (default vacío). Sin estos, los pagos quedan deshabilitados.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_URL=
NGROK_URL=
# Opcional (default: http://localhost:5173)
# VITE_FRONTEND_URL=http://localhost:5173

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Opcionales (defaults). *_per_minute = tokens repuestos por minuto; *_burst = tope del balde.
# rate_limit_default: límite general para todos los endpoints.
# rate_limit_auth:    límite estricto para login/register/logout (mitiga fuerza bruta).
# RATE_LIMIT_DEFAULT_PER_MINUTE=60
# RATE_LIMIT_DEFAULT_BURST=60
# RATE_LIMIT_AUTH_PER_MINUTE=5
# RATE_LIMIT_AUTH_BURST=5

# ─── Logging ─────────────────────────────────────────────────────────────────
# Opcional (default: INFO). Valores: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO
